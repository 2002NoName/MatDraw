generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  TUTOR
  STUDENT
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique @db.VarChar(191)
  /// Imię i nazwisko.
  name         String        @db.VarChar(120)
  /// Nazwa widoczna dla innych uczestników tablicy (lista uczestników, kursory).
  displayName  String        @db.VarChar(60)
  role         Role
  passwordHash String        @db.VarChar(100)
  createdAt    DateTime      @default(now())
  ownedBoards  Board[]       @relation("BoardOwner")
  memberships  BoardMember[]
  invites      Invite[]

  @@map("users")
}

model Board {
  id        String        @id @default(cuid())
  title     String        @db.VarChar(200)
  ownerId   String
  owner     User          @relation("BoardOwner", fields: [ownerId], references: [id])
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  members   BoardMember[]
  invites   Invite[]
  state     BoardState?

  @@index([ownerId])
  @@map("boards")
}

model BoardMember {
  boardId  String
  userId   String
  canEdit  Boolean  @default(true)
  joinedAt DateTime @default(now())
  board    Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([boardId, userId])
  @@index([userId])
  @@map("board_members")
}

model Invite {
  id          String    @id @default(cuid())
  code        String    @unique @db.VarChar(16)
  boardId     String
  createdById String
  label       String?   @db.VarChar(120)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  maxUses     Int?
  uses        Int       @default(0)
  revoked     Boolean   @default(false)
  board       Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  createdBy   User      @relation(fields: [createdById], references: [id])

  @@index([boardId])
  @@map("invites")
}

/// Zserializowany dokument Yjs tablicy (Y.encodeStateAsUpdate).
model BoardState {
  boardId   String   @id
  data      Bytes    @db.LongBlob
  updatedAt DateTime @updatedAt
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@map("board_states")
}
