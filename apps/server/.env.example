# Port HTTP serwera (API + WebSocket /ws + statyczny klient)
PORT=4000

# Magazyn danych: "prisma" (MySQL, produkcja) lub "memory" (tylko dev/testy – dane znikają po restarcie)
STORE=prisma
DATABASE_URL="mysql://matdraw:matdraw@localhost:3306/matdraw"

# Sekret do podpisywania tokenów JWT – USTAW LOSOWY, DŁUGI CIĄG (min. 32 znaki)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Sekret pozwalający założyć konto korepetytorki z poziomu formularza rejestracji.
# Pusty = rejestracja korepetytorek wyłączona (konto zakłada się skryptem `npm run create-tutor`).
TUTOR_REGISTRATION_SECRET=

# Dozwolone originy innych niż sam serwer (przecinek), np. serwer deweloperski Vite.
# Klient serwowany przez ten serwer (ten sam origin) nie wymaga wpisu.
CORS_ORIGINS=http://localhost:5173

# Katalog ze zbudowanym klientem (serwowany pod "/"). Puste = nie serwuj.
CLIENT_DIST=../client/dist

# --- WebRTC / ICE ---
# Serwery STUN (przecinek)
STUN_URLS=stun:stun.l.google.com:19302
# Serwery TURN (przecinek), np. turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
TURN_URLS=
# Wariant A (zalecany): wspólny sekret coturn (static-auth-secret) – krótkotrwałe poświadczenia HMAC
TURN_SECRET=
# Wariant B: stałe poświadczenia TURN
TURN_USERNAME=
TURN_CREDENTIAL=
# Ważność poświadczeń TURN w sekundach
TURN_TTL=86400

# --- Dane początkowe (npm run seed) ---
# Hasło konta korepetytorki Weroniki Janeczek przy pierwszym utworzeniu. Puste = domyślne "Tablica#Matura2025".
SEED_TUTOR_PASSWORD=
